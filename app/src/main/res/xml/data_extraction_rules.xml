<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up game history and settings, and copy them to a new device. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
